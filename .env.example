PORT=3000
RESULTS_PROVIDER=football-data
ADMIN_PASSWORD=
DATABASE_URL=postgres://worldcup:worldcup@localhost:55432/worldcup
# Provider options: football-data, mock, openfootball, api-football.
# football-data.org is the default free World Cup provider.
FOOTBALL_DATA_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_COMPETITION=WC
# OpenFootball is a free public-domain schedule fixture provider.
OPENFOOTBALL_BASE_URL=https://raw.githubusercontent.com/openfootball/worldcup/master/2026--usa
# Set RESULTS_PROVIDER=api-football and provide this on Railway/local env for paid near-real-time data.
API_FOOTBALL_KEY=
